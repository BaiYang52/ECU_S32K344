        <register>
          <name>CONFIG_DFPR_ALT</name>
          <description>Configuration Data Flash Memory Protected Region Alternate</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0</resetValue>
          <resetMask>0</resetMask>
          <fields>
            <field>
              <name>INVERT_VALUE_DFPR</name>
