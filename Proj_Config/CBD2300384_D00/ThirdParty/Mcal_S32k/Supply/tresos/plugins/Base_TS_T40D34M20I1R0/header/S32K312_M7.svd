                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSE_CLK_MODE_OPTION_2</name>
                  <description>10b and 11b both are applicable for clocking option B in same way. Ratio of 1:4 in between HSE IPS interface clock (AIPS_SLOW_CLK) and HSE module clock (HSE_CLK), HSE_IAHB gasket enabled.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSE_CLK_MODE_OPTION_3</name>
                  <description>10b and 11b both are applicable for clocking option B in same way. Ratio of 1:4 in between HSE IPS interface clock (AIPS_SLOW_CLK) and HSE module clock (HSE_CLK), HSE_IAHB gasket enabled.</description>
                  <value>0x3</value>
                </enumeratedValue>
