                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFT_LOCK_1</name>
                  <description>Write access is not allowed</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HARD_LOCK</name>
              <description>Hard Lock</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HARD_LOCK_0</name>
                  <description>Write access is allowed</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HARD_LOCK_1</name>
                  <description>Write access is not allowed until next functional reset</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIG_PE_LOCK</name>
