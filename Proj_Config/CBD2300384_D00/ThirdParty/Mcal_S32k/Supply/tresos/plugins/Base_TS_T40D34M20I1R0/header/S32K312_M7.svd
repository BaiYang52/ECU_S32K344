              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PE_LOCK_BLOCK_3_0</name>
                  <description>Block 3 lock request is clear</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PE_LOCK_BLOCK_3_1</name>
                  <description>Block 3 lock requested</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PE_LOCK_BLOCK_4</name>
              <description>Program/Erase Lock for Block 4</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PE_LOCK_BLOCK_4_0</name>
                  <description>Block 4 lock request is clear</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PE_LOCK_BLOCK_4_1</name>
                  <description>Block 4 lock requested</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PE_LOCK_UTEST</name>
              <description>Program/Erase Lock for UTEST</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PE_LOCK_UTEST_0</name>
